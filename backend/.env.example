# ContextLock Zero - Backend Environment Variables

# (Optional) Gemini AI API Key for Live Generative Extraction
# If omitted, ContextLock Zero uses its built-in deterministic AST extraction engine.
GEMINI_API_KEY=

# Allowed CORS Origins (comma-separated or * for all)
ALLOWED_ORIGINS=*

# Custom SQLite database file location (defaults to local contextlock.db)
DATABASE_PATH=

# Server Host & Port
HOST=0.0.0.0
PORT=8000
RELOAD=false
